<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="me.zhengjie.invest.mapper.BinanceCoinFuturesTradeInfoMapper">
    <resultMap id="BaseResultMap" type="me.zhengjie.invest.domain.BinanceCoinFuturesTradeInfo">
        <id column="id" property="id"/>
        <result column="uid" property="uid"/>
        <result column="symbol" property="symbol"/>
        <result column="order_id" property="orderId"/>
        <result column="price" property="price"/>
        <result column="qty" property="qty"/>
        <result column="base_qty" property="baseQty"/>
        <result column="commission" property="commission"/>
        <result column="commission_asset" property="commissionAsset"/>
        <result column="time" property="time"/>
        <result column="buyer" property="buyer"/>
        <result column="maker" property="maker"/>
        <result column="realized_pnl" property="realizedPnl"/>
        <result column="side" property="side"/>
        <result column="position_side" property="positionSide"/>
        <result column="pair" property="pair"/>
        <result column="margin_asset" property="marginAsset"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, uid, symbol, order_id, price, qty, base_qty, commission, commission_asset, time, buyer, maker, realized_pnl, side, position_side, pair, margin_asset
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM binance_coin_futures_trade_info t1
        WHERE 1 = 1
        ORDER BY t1.id DESC
    </select>
</mapper>