<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="me.zhengjie.iou.mapper.IouUserMapper">
    <resultMap id="BaseResultMap" type="me.zhengjie.iou.domain.IouUser">
        <id column="id" property="id"/>
        <result column="mobile" property="mobile"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="real_name" property="realName"/>
        <result column="id_no_encrypted" property="idNoEncrypted"/>
        <result column="id_no_hash" property="idNoHash"/>
        <result column="verify_status" property="verifyStatus"/>
        <result column="verified_at" property="verifiedAt"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, mobile, password_hash, real_name, id_no_encrypted, id_no_hash, verify_status, verified_at, create_time, update_time
    </sql>

    <select id="findAll" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM iou_user t1
        WHERE 1 = 1
            <if test="criteria.mobile != null and criteria.mobile != ''">
                AND t1.mobile = #{criteria.mobile}
            </if>
            <if test="criteria.realName != null and criteria.realName != ''">
                AND t1.real_name LIKE CONCAT('%',#{criteria.realName},'%')
            </if>
            <if test="criteria.verifyStatus != null">
                AND t1.verify_status = #{criteria.verifyStatus}
            </if>
            <if test="criteria.createTime != null and criteria.createTime.size() > 1">
                AND t1.create_time BETWEEN #{criteria.createTime[0]} AND #{criteria.createTime[1]}
            </if>
        ORDER BY t1.id DESC
    </select>
</mapper>
